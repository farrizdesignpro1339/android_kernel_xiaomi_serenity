CONFIG_SPRD_DEBUG=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_IIO_DEBUGFS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_MEMORY_INIT=y
# Fault injection:
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAIL_MAKE_REQUEST=y
CONFIG_FAULT_INJECTION_DEBUGFS=y
CONFIG_SPRD_DEBUG_GIC=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_SCHED_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_SPRD_HANG_TRIGGER=y
CONFIG_SPRD_MINIDUMP_FTRACE=y
CONFIG_UNISOC_IOLIMIT=y
CONFIG_SPRD_AUTOTEST=y
CONFIG_SPRD_AUTOTEST_GPIO=y
CONFIG_SPRD_AUTOTEST_PINCTRL=y
CONFIG_SPRD_TIMER_TEST=y
